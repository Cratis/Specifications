<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Specifications.TUnit.Specs</AssemblyName>
        <RootNamespace>Cratis.Specifications</RootNamespace>
        <IsPackable>false</IsPackable>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>disable</Nullable>
        <NoWarn>$(NoWarn);CA1707;CS1591;RCS1213;IDE0051;IDE1006;CA1051;SA1633;RCS1090;SA1649;SA1600;SA1310;SA1502;SA1134;MA0048;CA1002;MA0016;CA1515;NU1701;CA1812;IDE0060;CA1001;CA1861;IDE0200</NoWarn>
    </PropertyGroup>

    <!-- The framework-free assertion catalog is shared by every package's specs. -->
    <ItemGroup>
        <Compile Include="../Shared.Specs/Assertions/*.cs" Link="Assertions/%(Filename)%(Extension)" />
        <Compile Include="../Shared.Specs/Observation/*.cs" Link="Observation/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Specifications/Specifications.csproj" />
        <ProjectReference Include="../TUnit/TUnit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
    </ItemGroup>

    <!-- Compile the session hook the package adds to its consumers. The rest of the package targets is not imported:
         the specs declare the readable-names attribute themselves. -->
    <ItemGroup>
        <Compile Include="../TUnit/buildTransitive/CratisSpecificationsSession.TUnit.g.cs" Link="CratisSpecificationsSession.TUnit.g.cs" />
    </ItemGroup>
</Project>
