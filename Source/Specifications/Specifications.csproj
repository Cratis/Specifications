<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Specifications</AssemblyName>
        <RootNamespace>Cratis.Specifications</RootNamespace>
        <IsPackable>true</IsPackable>
        <EnablePackageValidation>true</EnablePackageValidation>
        <Nullable>enable</Nullable>
        <!-- Ships inside the AOT native runner, so it must stay trim and AOT analyzable. -->
        <IsAotCompatible>true</IsAotCompatible>
        <!-- The only package that carries the analyzers; the flavor packages receive them through this dependency. -->
        <CratisBundleAnalyzers>true</CratisBundleAnalyzers>
    </PropertyGroup>

    <!-- The lifecycle invoker is shared with the framework-specific packages. -->
    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Specifications.XUnit" />
        <InternalsVisibleTo Include="Cratis.Specifications.XUnit.v3" />
        <InternalsVisibleTo Include="Cratis.Specifications.NUnit" />
        <InternalsVisibleTo Include="Cratis.Specifications.NUnit5" />
        <InternalsVisibleTo Include="Cratis.Specifications.TUnit" />
    </ItemGroup>

    <!-- The shared resources module initializer under buildTransitive compiles into consumers, not into this package. -->
    <ItemGroup>
        <Compile Remove="buildTransitive/**" />
    </ItemGroup>
</Project>
