<Project>
    <ItemGroup Condition="'$(CratisSpecificationsReadableNames)' != 'false'">
        <AssemblyAttribute Include="Cratis.Specifications.ReadableSpecificationNamesAttribute" />
    </ItemGroup>
    <!-- CratisSpecificationsAnalyzers turns the bundled CRSPEC analyzers off. Only the Cratis.Specifications package carries
         Cratis.Specifications.CodeAnalysis.dll and every other package depends on it, so this one file is imported once
         for all of them. The analyzers are removed right after the SDK has added the package analyzers to @(Analyzer),
         which also runs for design-time builds. Only the CodeAnalysis assembly is removed: other analyzers and the
         native runner's source generator (Cratis.Specifications.Runner.Generator.dll) are untouched.
         false = off everywhere; ide = keep them in IDE design-time builds, off in command-line builds. -->
    <PropertyGroup>
        <_CratisRemoveAnalyzers Condition="'$(CratisSpecificationsAnalyzers)' == 'false'">true</_CratisRemoveAnalyzers>
        <_CratisRemoveAnalyzers Condition="'$(CratisSpecificationsAnalyzers)' == 'ide' And '$(DesignTimeBuild)' != 'true' And '$(BuildingInsideVisualStudio)' != 'true'">true</_CratisRemoveAnalyzers>
    </PropertyGroup>

    <Target Name="CratisSpecificationsRemoveAnalyzers"
            AfterTargets="ResolveLockFileAnalyzers"
            Condition="'$(_CratisRemoveAnalyzers)' == 'true'">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)%(Extension)' == 'Cratis.Specifications.CodeAnalysis.dll'" />
        </ItemGroup>
    </Target>

    <!--
        Phase timings: emitted only when set, so a project that does not use them gets nothing.
        Flows to the consumers of every adapter package through their reference to this package.
    -->
    <ItemGroup Condition="'$(CratisSpecificationsPhaseTimings)' == 'true'">
        <AssemblyMetadata Include="CratisSpecificationsPhaseTimings" Value="true" />
    </ItemGroup>
    <ItemGroup Condition="'$(CratisSpecificationsSlowPhaseThreshold)' != ''">
        <AssemblyMetadata Include="CratisSpecificationsSlowPhaseThreshold" Value="$(CratisSpecificationsSlowPhaseThreshold)" />
    </ItemGroup>
    <ItemGroup Condition="'$(CratisSpecificationsPhaseTimingsFile)' != ''">
        <AssemblyMetadata Include="CratisSpecificationsPhaseTimingsFile" Value="$(CratisSpecificationsPhaseTimingsFile)" />
    </ItemGroup>

    <!--
        Shared resource leases (experimental): compiled in only when set, so a project that does not lease keeps the
        unobserved fast path. The module initializer registers the observer that releases leases after Destroy.
    -->
    <ItemGroup Condition="'$(CratisSpecificationsSharedResources)' == 'true' And '$(Language)' == 'C#'">
        <Compile Include="$(MSBuildThisFileDirectory)CratisSpecificationsSharedResources.g.cs" Visible="false" />
    </ItemGroup>
</Project>
