<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Specifications.NUnit</AssemblyName>
        <RootNamespace>Cratis.Specifications</RootNamespace>
        <IsPackable>true</IsPackable>
        <EnablePackageValidation>true</EnablePackageValidation>
        <Description>Specification by Example (BDD) for .NET with NUnit - Given/When/Then specifications in the style of Machine.Specifications, running on the NUnit test framework.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="nunit" />
    </ItemGroup>

    <ItemGroup>
        <!-- Flow Cratis.Specifications buildTransitive (opt-in properties such as CratisSpecificationsReadableNames) to consumers of this package. -->
        <ProjectReference Include="../Specifications/Specifications.csproj" PrivateAssets="contentfiles;analyzers" />
    </ItemGroup>

    <ItemGroup>
        <!-- The session hook under buildTransitive compiles into consumers, not into this package. -->
        <Compile Remove="buildTransitive/**" />
    </ItemGroup>
</Project>
