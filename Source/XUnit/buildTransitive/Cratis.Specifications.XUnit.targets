<Project>
    <ItemGroup Condition="'$(CratisSpecificationsSharedLifecycle)' == 'true' Or '$(CratisSpecificationsReadableNames)' == 'true'">
        <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
            <_Parameter1>Cratis.Specifications.SpecificationTestFramework</_Parameter1>
            <_Parameter2>Cratis.Specifications.XUnit</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup Condition="'$(CratisSpecificationsReadableNames)' == 'true' And '$(CratisSpecificationsSharedLifecycle)' != 'true'">
        <AssemblyAttribute Include="Cratis.Specifications.PerFactSpecificationLifecycleAttribute" />
    </ItemGroup>
</Project>
