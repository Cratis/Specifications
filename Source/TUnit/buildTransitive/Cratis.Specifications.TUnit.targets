<Project>
    <!-- CratisSpecificationsSharedLifecycle is accepted: this framework already shares the specification context. -->
    <ItemGroup Condition="'$(CratisSpecificationsReadableNames)' != 'false'">
        <AssemblyAttribute Include="Cratis.Specifications.SpecificationDisplayNameAttribute" />
    </ItemGroup>

    <!-- Ends the Cratis specification session once every specification has run. Inert unless something registered for the end of the session. -->
    <ItemGroup Condition="'$(CratisSpecificationsSessionHook)' != 'false'">
        <Compile Include="$(MSBuildThisFileDirectory)CratisSpecificationsSession.TUnit.g.cs" Visible="false" />
    </ItemGroup>
</Project>
