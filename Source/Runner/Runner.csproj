<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Specifications.Runner</AssemblyName>
        <RootNamespace>Cratis.Specifications</RootNamespace>
        <IsPackable>true</IsPackable>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>4.5.0</PackageValidationBaselineVersion>
        <Description>Specification by Example (BDD) for .NET with a native runner on Microsoft.Testing.Platform - Given/When/Then specifications with one shared context per specification class, source generated discovery and no runtime reflection.</Description>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Platform" />
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <!-- Flow Cratis.Specifications buildTransitive (opt-in properties such as CratisSpecificationsReadableNames) to consumers of this package. -->
        <ProjectReference Include="../Specifications/Specifications.csproj" PrivateAssets="contentfiles;analyzers" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Specifications.Runner.Specs" />
    </ItemGroup>

    <!-- The source generator is bundled into analyzers/dotnet/cs (the CodeAnalysis analyzers come with the Cratis.Specifications dependency); the props make a referencing
         project an executable Microsoft.Testing.Platform test application with this framework registered. -->
    <ItemGroup>
        <ProjectReference Include="../Runner.Generator/Runner.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../Runner.Generator/bin/$(Configuration)/netstandard2.0/Cratis.Specifications.Runner.Generator.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="build/Cratis.Specifications.Runner.props" Pack="true" PackagePath="build" />
        <None Include="buildTransitive/Cratis.Specifications.Runner.props" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>
</Project>
