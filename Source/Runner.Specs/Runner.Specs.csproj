<Project Sdk="Microsoft.NET.Sdk">
    <!-- The specifications of the runner, run by the runner itself. Referencing the projects instead of the package,
         the generator and the package props are brought in explicitly. -->
    <Import Project="../Runner/buildTransitive/Cratis.Specifications.Runner.props" />

    <PropertyGroup>
        <AssemblyName>Cratis.Specifications.Runner.Specs</AssemblyName>
        <RootNamespace>Cratis.Specifications.Runner</RootNamespace>
        <IsPackable>false</IsPackable>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>disable</Nullable>
        <NoWarn>$(NoWarn);CA1707;CS1591;RCS1213;IDE0051;IDE1006;CA1051;SA1633;RCS1090;SA1649;SA1600;SA1310;SA1502;SA1134;MA0048;CA1002;MA0016;CA1515;NU1701;CA1812;IDE0060;CA1001;CA1861;IDE0200;CA1822</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Runner/Runner.csproj" />
        <ProjectReference Include="../Runner.Specs.Probes/Runner.Specs.Probes.csproj" />
        <ProjectReference Include="../Runner.Generator/Runner.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
