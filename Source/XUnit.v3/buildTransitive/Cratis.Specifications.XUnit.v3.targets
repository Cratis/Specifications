<Project>
    <ItemGroup Condition="'$(CratisSpecificationsSharedLifecycle)' != 'false' Or '$(CratisSpecificationsReadableNames)' != 'false'">
        <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
            <_Parameter1>typeof(global::Cratis.Specifications.SpecificationTestFramework)</_Parameter1>
            <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup Condition="'$(CratisSpecificationsSharedLifecycle)' == 'false'">
        <AssemblyAttribute Include="Cratis.Specifications.PerFactSpecificationLifecycleAttribute" />
    </ItemGroup>
    <!-- Registers the assertion failure factory when the test assembly loads, ahead of any specification. -->
    <ItemGroup Condition="'$(CratisSpecificationsAssertionFailures)' != 'false' And '$(Language)' == 'C#'">
        <Compile Include="$(MSBuildThisFileDirectory)CratisSpecificationsAssertionFailures.XUnit.g.cs" Visible="false" />
    </ItemGroup>
</Project>
