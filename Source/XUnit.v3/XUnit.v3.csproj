<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Specifications.XUnit.v3</AssemblyName>
        <RootNamespace>Cratis.Specifications</RootNamespace>
        <IsPackable>true</IsPackable>
        <EnablePackageValidation>true</EnablePackageValidation>
        <Description>Specification by Example (BDD) for .NET with xUnit v3 - Given/When/Then specifications in the style of Machine.Specifications, running on the xUnit v3 test framework.</Description>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.extensibility.core" />
        <PackageReference Include="xunit.v3.assert" />
    </ItemGroup>

    <ItemGroup>
        <!-- Flow Cratis.Specifications buildTransitive (opt-in properties such as CratisSpecificationsReadableNames) to consumers of this package. -->
        <ProjectReference Include="../Specifications/Specifications.csproj" PrivateAssets="contentfiles;analyzers" />
    </ItemGroup>

    <!-- The assertions live in Cratis.Specifications; the type forwards and the failure factory are shared with the xUnit v2 package. -->
    <ItemGroup>
        <Compile Include="../XUnit/TypeForwards.cs;../XUnit/AssertionFailureFactory.cs" Link="%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- The assertion failure registration compiled into consumers is shared with the xUnit v2 package. -->
        <None Include="../XUnit/buildTransitive/CratisSpecificationsAssertionFailures.XUnit.g.cs" Pack="true" PackagePath="buildTransitive/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Specifications.XUnit.v3.Specs" />
    </ItemGroup>
</Project>
