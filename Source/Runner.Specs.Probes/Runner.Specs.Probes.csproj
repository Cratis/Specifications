<Project Sdk="Microsoft.NET.Sdk">
    <!-- Specification classes the runner specifications run on purpose, including failing ones. They live in their own
         assembly, so they are registered under it and never run as part of the specifications of the runner itself.
         The executable also exercises MTP's terminal nodes and exit status through dotnet test. -->
    <Import Project="../Runner/buildTransitive/Cratis.Specifications.Runner.props" />
    <PropertyGroup>
        <AssemblyName>Cratis.Specifications.Runner.Specs.Probes</AssemblyName>
        <RootNamespace>Cratis.Specifications.Probes</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>disable</Nullable>
        <NoWarn>$(NoWarn);CA1707;CS1591;RCS1213;IDE0051;IDE1006;CA1051;SA1633;RCS1090;SA1649;SA1600;SA1310;SA1502;SA1134;MA0048;CA1002;MA0016;CA1515;CA1812;IDE0060;CA1001;CA1822;CA1063;CA1816;CA2201;CS0108;CS0114;SA1402;MA0012;CA1065;CA1034</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Project references skip the buildTransitive targets, so opt into readable names the way they do. -->
        <AssemblyAttribute Include="Cratis.Specifications.ReadableSpecificationNamesAttribute" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Runner/Runner.csproj" />
        <ProjectReference Include="../Runner.Generator/Runner.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
