<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Specifications.NUnit.Specs</AssemblyName>
        <RootNamespace>Cratis.Specifications</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>disable</Nullable>
        <!-- The NUnit 4 package compares ShouldEqual(params) without regard to order; the shared catalog expects that. -->
        <DefineConstants>$(DefineConstants);NUNIT4</DefineConstants>
        <!-- CA1812 is suppressed because probe specifications are only instantiated by the specs that exercise them. -->
        <NoWarn>$(NoWarn);CA1707;CS1591;RCS1213;IDE0051;IDE1006;CA1051;SA1633;RCS1090;SA1649;SA1600;SA1310;SA1502;SA1134;MA0048;CA1002;MA0016;CA1515;NU1701;CA1812;IDE0060;CA1001</NoWarn>
    </PropertyGroup>

    <!-- The specs are shared with the NUnit 5 package specs: the same behavior must hold on NUnit 4. -->
    <!-- The framework-free assertion catalog is shared by every package's specs. -->
    <ItemGroup>
        <Compile Include="../Shared.Specs/Assertions/*.cs" Link="Assertions/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../NUnit5.Specs/**/*.cs" Exclude="../NUnit5.Specs/obj/**;../NUnit5.Specs/bin/**" LinkBase="Shared" />
    </ItemGroup>

    <!-- The lifecycle probes are shared with the xUnit specs. -->
    <ItemGroup>
        <Compile Include="../XUnit.Specs/for_SpecificationMethods/probes/*.cs" Link="for_SpecificationMethods/probes/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Specifications/Specifications.csproj" />
        <ProjectReference Include="../NUnit/NUnit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="nunit" />
        <PackageReference Include="Microsoft.NET.Test.SDK" />
        <PackageReference Include="NUnit3TestAdapter">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
