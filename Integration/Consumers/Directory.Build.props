<Project>
    <!-- Consumers deliberately use ordinary SDK defaults, not the library's packaging settings. -->
    <PropertyGroup>
        <ConsumerFramework Condition="'$(ConsumerFramework)' == ''">net11.0</ConsumerFramework>
        <TargetFramework>$(ConsumerFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
</Project>
