<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Specifications.Sample.TUnit</AssemblyName>
        <RootNamespace>Cratis.Specifications.Sample</RootNamespace>
        <IsPackable>false</IsPackable>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>disable</Nullable>
        <NoWarn>$(NoWarn);CA1707;CS1591;RCS1213;IDE0051;IDE1006;CA1051;SA1633;RCS1090;SA1649;SA1600;SA1310;SA1502;SA1134;MA0048;CA1002;MA0016;CA1515;NU1701</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../Source/Specifications/Specifications.csproj"/>
        <ProjectReference Include="../../Source/TUnit/TUnit.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)/../Common/**/*.cs"/>
    </ItemGroup>
</Project>
