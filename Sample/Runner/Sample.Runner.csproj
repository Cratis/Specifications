<Project Sdk="Microsoft.NET.Sdk">
    <!-- Referencing the projects instead of the package, the generator and the package props are brought in explicitly.
         A consumer only references the Cratis.Specifications.Runner package. -->
    <Import Project="../../Source/Runner/buildTransitive/Cratis.Specifications.Runner.props" />

    <PropertyGroup>
        <AssemblyName>Cratis.Specifications.Sample.Runner</AssemblyName>
        <RootNamespace>Cratis.Specifications.Sample</RootNamespace>
        <IsPackable>false</IsPackable>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>disable</Nullable>
        <NoWarn>$(NoWarn);CA1707;CS1591;RCS1213;IDE0051;IDE1006;CA1051;SA1633;RCS1090;SA1649;SA1600;SA1310;SA1502;SA1134;MA0048;CA1002;MA0016;CA1515;NU1701</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../Source/Runner/Runner.csproj" />
        <ProjectReference Include="../../Source/Runner.Generator/Runner.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)/../Common/**/*.cs" />
    </ItemGroup>
</Project>
