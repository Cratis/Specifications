<Project>
  <!-- BDN's generated project sets ImportDirectoryBuildProps too late for SDK props import.
       Do not let the repository's multi-targeting defaults leak into that single-TFM host. -->
  <Import Project="../../Directory.Build.props" Condition="'$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'" />
  <PropertyGroup>
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>
</Project>
