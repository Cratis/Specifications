# BenchmarkDotNet's generated host and xUnit discovery require public benchmark/fixture classes.
[*.cs]
dotnet_diagnostic.CA1515.severity = none
# Lifecycle methods are invoked by convention/reflection, not direct source calls.
dotnet_diagnostic.IDE0051.severity = none
